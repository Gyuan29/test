LOCAL_SQLITE_PATH=./.local/d1.sqlite
LOCAL_AUTH_SQLITE_PATH=./.local/auth.sqlite
LOCAL_AUTH_SQLITE_PATH=./.local/auth.sqlite

# OpenAI-compatible LLM endpoint. Defaults to a local Ollama server.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5:3b
# Dedicated model for organization-name validation. Prefer a stronger reasoning model;
# falls back to LLM_MODEL_NAME when empty. Must exist in the configured API gateway.
CLEAN_ORG_MODEL_NAME=qwen2.5:3b
# Maximum concurrent organization-name LLM requests (keep at 2-3 for gateway stability).
NAME_CLEAN_LLM_CONCURRENCY=2
# Maximum concurrent worker tasks; LLM calls remain capped by NAME_CLEAN_LLM_CONCURRENCY.
NAME_CLEAN_WORK_CONCURRENCY=3

# Optional department fine-tuned model. Keep these commented/empty until ready.
FINE_TUNED_MODEL_BASE_URL=
FINE_TUNED_MODEL_NAME=

# SearXNG must run independently outside this project directory.
# Configure multiple instances as a comma-separated pool; SEARXNG_URL is the legacy single-instance fallback.
SEARXNG_URLS=http://localhost:8080
SEARXNG_URL=http://localhost:8080
SEARXNG_ENGINES=google,bing,duckduckgo,baidu,startpage,qwant
# Optional static browser session cookies. Automatic Cookie Jar management is enabled;
# use this only to force/override cookies or handle unusual static-cookie requirements.
GLOBAL_COOKIE=
SEARXNG_COOKIE=
# Keep disabled unless a trusted target has a known certificate problem.
ALLOW_INSECURE_SSL=false

# Required by the local Cloudflare/Wrangler worker for credential encryption.
# Generate a random 32-byte value (base64 or hex) for non-local deployments.
CREDENTIAL_ENCRYPTION_KEY=

# Private workspace authentication. Set exactly one password value:
# AUTH_PASSWORD is plaintext and is converted to PBKDF2 automatically.
# AUTH_PASSWORD_HASH (when a valid pbkdf2$sha256$... value is provided) takes priority.
# The configured email is promoted to admin on successful login; public registration is user-only.
AUTH_EMAIL=research@example.com
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# To use a department OpenAI-compatible endpoint, change only:
# LLM_BASE_URL, LLM_API_KEY, and LLM_MODEL_NAME.

# Pipeline tuning (defaults preserve current behavior)
MIN_RELEVANCE_SCORE=4
SEARXNG_CONCURRENCY=8
HOMEPAGE_CONCURRENCY=4
LLM_CONCURRENCY=3
LLM_TIMEOUT_MS=60000
# Set true only while diagnosing an llm_parse_failed response; logs full prompts and raw output.
DEBUG_LLM_FULL_OUTPUT=false



DISCOVERY_TIMEOUT_MS=10000
ENRICH_REQUEST_TIMEOUT_MS=5000
ENRICH_REQUEST_DELAY_MS=1500
ENRICH_LLM_TIMEOUT_MS=120000
EVENT_LOOKBACK_DAYS=365

# 结构化新闻提取器（默认关闭；仅 ENABLE_NEWS_EXTRACTOR=true 时接入搜索管道）
# 是否启用规则化新闻正文提取，默认 false 以保持原有搜索行为。
ENABLE_NEWS_EXTRACTOR=false
# Extractor 同时处理的 URL 数量，默认 4；数值越大吞吐越高但网络压力越大。
NEWS_EXTRACTOR_CONCURRENCY=4
# 单篇文章正文最大字符数，默认 8000，超出部分会按段落边界截断。
NEWS_EXTRACTOR_MAX_CHARS=8000
# 判定正文提取成功所需的最小字符数，默认 160；不足时使用摘要回退。
NEWS_EXTRACTOR_MIN_BODY_CHARS=160



# 每日 AI 情报简报（默认关闭，需显式启用并配置 Webhook）
# 是否启用每日简报任务，默认 false。
ENABLE_DAILY_BRIEFING=false
# 查询最近多少小时内的事件，默认 24 小时。
DAILY_BRIEFING_LOOKBACK_HOURS=24
# 纳入简报的最低相关性分数，默认 6（范围通常为 0-10）。
DAILY_BRIEFING_MIN_SCORE=6
# 单次最多交给 LLM 的事件数，默认 60。
DAILY_BRIEFING_MAX_EVENTS=60
# LLM 简报输出的最大 token 数，默认 3000。
DAILY_BRIEFING_MAX_OUTPUT_TOKENS=3000

# Webhook 通知配置
# 推送平台类型：feishu、dingtalk、wework 或 generic，默认 generic。
WEBHOOK_PROVIDER=generic
# Webhook 接收地址；为空时不执行推送。
WEBHOOK_URL=
# Webhook 请求超时时间（毫秒），默认 15000。
WEBHOOK_TIMEOUT_MS=15000
# 网络错误或 5xx 响应的重试次数，默认 2 次。
WEBHOOK_RETRY_COUNT=2
# 单条推送正文最大字节数，默认 18000。
WEBHOOK_MAX_BYTES=18000
# 可选的平台专用地址；未设置时回退到 WEBHOOK_URL。
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
WEWORK_WEBHOOK_URL=
# ==========================================
# Phase 2: 统一配置与超时管理
# ==========================================

# 新闻请求总超时 (毫秒)
NEWS_REQUEST_TIMEOUT_MS=20000

# 单篇新闻正文提取超时 (毫秒)
NEWS_EXTRACTOR_TIMEOUT_MS=20000

# HTTP 总请求超时 (毫秒)
HTTP_TIMEOUT_MS=20000

# TCP/TLS 建连超时，避免 Undici 默认 10 秒导致过早失败 (毫秒)
HTTP_CONNECT_TIMEOUT_MS=20000

# Extractor 最大重试次数 (0-2)
EXTRACTOR_RETRIES=2

# 新闻请求失败后的重试基础延迟 (毫秒)
NEWS_RETRY_BACKOFF_MS=250

# 新闻来源链接和去重结果限制
NEWS_MAX_SOURCE_LINKS=20
NEWS_NO_WEBSITE_MAX_RESULTS=10
NEWS_MAX_DEDUPE_RESULTS=10
