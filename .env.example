LOCAL_SQLITE_PATH=./.local/d1.sqlite

# OpenAI-compatible LLM endpoint. Defaults to a local Ollama server.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5:3b

# Optional department fine-tuned model. Keep these commented/empty until ready.
FINE_TUNED_MODEL_BASE_URL=
FINE_TUNED_MODEL_NAME=

# SearXNG must run independently outside this project directory.
# Configure multiple instances as a comma-separated pool; SEARXNG_URL is the legacy single-instance fallback.
SEARXNG_URLS=http://localhost:8080
SEARXNG_URL=http://localhost:8080
SEARXNG_ENGINES=google,bing,duckduckgo,baidu,startpage,qwant

# Required by the local Cloudflare/Wrangler worker for credential encryption.
# Generate a random 32-byte value (base64 or hex) for non-local deployments.
CREDENTIAL_ENCRYPTION_KEY=

# Private workspace authentication. Set exactly one password value:
# AUTH_PASSWORD is plaintext and is converted to PBKDF2 automatically.
# AUTH_PASSWORD_HASH (when a valid pbkdf2$sha256$... value is provided) takes priority.
# The configured email is promoted to admin on successful login; public registration is user-only.
AUTH_EMAIL=research@example.com
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=

# To use a department OpenAI-compatible endpoint, change only:
# LLM_BASE_URL, LLM_API_KEY, and LLM_MODEL_NAME.
